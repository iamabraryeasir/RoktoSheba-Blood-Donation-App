{
  "expo": {
    "name": "RoktoSheba",
    "slug": "rokto-sheba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roktosheba",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roktosheba.app",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "RoktoSheba needs access to your camera to take donor avatars and medical prescription photos.",
        "NSPhotoLibraryUsageDescription": "RoktoSheba needs access to your photo library to select profile avatars and medical prescriptions.",
        "NSLocationWhenInUseUsageDescription": "RoktoSheba needs your location to match nearby emergency blood donors and patients."
      }
    },
    "android": {
      "package": "com.roktosheba.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-navigation-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RoktoSheba needs access to your photo library to select profile avatars and medical prescriptions.",
          "cameraPermission": "RoktoSheba needs access to your camera to take donor avatars and medical prescription photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RoktoSheba needs your location to match nearby emergency blood donors and patients."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {},
      "eas": {
        "projectId": "9c1f83ee-6e47-4850-a89b-1e79c14b837f"
      }
    },
    "owner": "abraryeasir.ai"
  }
}